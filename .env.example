# 智谱 AI（GLM-4-Flash 免费） - https://bigmodel.cn/
# 注册后在「API 密钥」页面创建
ZHIPU_API_KEY=your_zhipu_api_key_here

# SiliconFlow（Embedding，200M 免费 tokens） - https://siliconflow.cn/
# 注册后在「API 密钥」页面创建
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 阿里云百炼（qwen-turbo 兜底） - https://bailian.console.aliyun.com/
# v0.5+ 启用，v0.5-1 作为智谱失败的兜底
QWEN_API_KEY=your_qwen_api_key_here

# ====== 应用配置 ======
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO